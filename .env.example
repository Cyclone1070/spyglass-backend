# Copy this file to `.env` and fill in the values.
# `.env` is gitignored and must never be committed.

# MongoDB Atlas connection string.
MONGO_CONNECTION_STRING=

# Cloudflare Tunnel tokens (backend tunnel and residential relay).
CLOUDFLARE_PROXY_TOKEN=
CLOUDFLARE_BACKEND_TOKEN=

# Cloudflare API token used by deployment agents (Workers, DNS, Tunnel).
# Create at https://dash.cloudflare.com/profile/api-tokens with:
#   Account: Workers Scripts Edit, Cloudflare Tunnel Edit
#   Zone:    Workers Routes Edit, DNS Edit, Zone Read
# Scope the token to this account and the hoangmai.dev zone.
#
# Never expose this token as a VITE_* variable or in the frontend bundle.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Export for wrangler without sourcing the whole .env (the Mongo URI contains
# shell-special characters):
#   export CLOUDFLARE_API_TOKEN=$(grep -E '^CLOUDFLARE_API_TOKEN=' .env | cut -d= -f2-)
#   export CLOUDFLARE_ACCOUNT_ID=$(grep -E '^CLOUDFLARE_ACCOUNT_ID=' .env | cut -d= -f2-)
#   export CLOUDFLARE_ZONE_ID=$(grep -E '^CLOUDFLARE_ZONE_ID=' .env | cut -d= -f2-)
