# Copy this file to `.env` and fill in the values.
# `.env` is gitignored and must never be committed.

# MongoDB Atlas connection string.
MONGO_CONNECTION_STRING=

# Cloudflare Tunnel tokens (backend tunnel and residential relay).
CLOUDFLARE_PROXY_TOKEN=
CLOUDFLARE_BACKEND_TOKEN=

# Cloudflare CLI credentials (wrangler) are deliberately not stored in this
# repo. They live in ~/repos/dotfiles/zsh/secrets.zsh, which is gitignored and
# loaded by zsh. Do not add CLOUDFLARE_API_TOKEN, ACCOUNT_ID, or ZONE_ID here.
